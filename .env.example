# Briitely OS Core — Environment Variables
#
# Copy this file to .env and fill in your own values.
# Never commit real secrets to version control.

# ── Application ──────────────────────────────────────────────
# The public URL where this app is deployed (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────
# Project URL and anon (publishable) key — safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Legacy alias: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY still works as a fallback.

# Service role key — server-side only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Briitely (HighLevel) Integration ────────────────────────
# Private integration token for the Briitely API.
BRIITELY_PRIVATE_INTEGRATION_TOKEN=your-private-integration-token

# Location ID (altId) for invoice and contact operations.
BRIITELY_LOCATION_ID=your-location-id

# Company ID — optional, used for user search lookups.
BRIITELY_COMPANY_ID=your-company-id

# ── Briitely Webhook Authentication ───────────────────────────
# Shared secret for authenticating Briitely workflow callbacks.
# Server-side only. Never expose to the browser or use NEXT_PUBLIC_ prefix.
BRIITELY_PORTAL_WEBHOOK_SECRET=your-webhook-secret

# Legacy aliases (still supported as fallbacks):
# GHL_PRIVATE_INTEGRATION_TOKEN, GHL_LOCATION_ID, GHL_COMPANY_ID
